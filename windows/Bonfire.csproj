<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Bonfire</AssemblyName><RootNamespace>Bonfire</RootNamespace>
    <Product>Bonfire</Product>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../VERSION').Trim())</Version>
    <FileVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '-beta\.', '.'))</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TargetFramework>net10.0-windows10.0.20348.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.20348.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.20348.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType><UseWinUI>true</UseWinUI><WinUISDKReferences>false</WinUISDKReferences>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling><PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon>app.ico</ApplicationIcon><DefaultLanguage>en</DefaultLanguage>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
    <Content Include="Assets/Games/*.png;app.ico" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="$(NativePath)/BonfireCore.dll" Link="BonfireCore.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NativePath)/BonfireCore.dll')"/>
    <Content Include="../vendor/NOTICES.txt" Link="NOTICES.txt" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
