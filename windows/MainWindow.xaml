<Window x:Class="Bonfire.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
  <Grid x:Name="Root"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TitleBar x:Name="AppBar" Title="Bonfire"><TitleBar.IconSource><ImageIconSource ImageSource="app.ico"/></TitleBar.IconSource></TitleBar>
    <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="1050" OpenPaneLength="220" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" AlwaysShowHeader="False">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="WorkNav" Tag="work"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Name="ManagerNav" Tag="manage"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems><NavigationViewItem x:Name="SettingsNav" Tag="settings" Icon="Setting"/></NavigationView.FooterMenuItems>
      <Grid Padding="28,20,28,20" RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel x:Name="Header" Spacing="8"/>
        <ContentControl x:Name="Surface" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
